# Kopieer naar .env en vul in
PROVIDER_MODE=mock                  # mock | live
DATABASE_URL=                       # leeg = SQLite (./vestigingsregister.db)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=                     # optioneel; betrouwbare zoek-fallback i.p.v. dure OpenAI web_search
KVK_API_KEY=                        # optioneel; zonder -> Places-fallback
JWT_SECRET=change-me
REGISTER_PEILDATUM=2026-04-01       # PM: bevestigen met Roger
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
EMAIL_DEMO_RECIPIENT=               # optioneel; alleen lokaal gebruiken om alle chat-mails om te leiden
DEMO_ARMINA_PASSWORD=               # optioneel; leeg -> seed_users genereert een tijdelijk wachtwoord
DEMO_ANITA_PASSWORD=                # optioneel; leeg -> seed_users genereert een tijdelijk wachtwoord
DEMO_ADMIN_PASSWORD=                # optioneel; leeg -> seed_users genereert een tijdelijk wachtwoord
